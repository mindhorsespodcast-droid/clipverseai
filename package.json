{
  "name": "clipverseai",
  "private": true,
  "description": "ClipVerse AI - long videos in, short Hinglish-captioned clips out.",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c white,yellow \"npm run dev --workspace=apps/web\" \"node scripts/run-worker.mjs\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:worker": "node scripts/run-worker.mjs",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "check-env": "node scripts/check-env.mjs",
    "setup:worker": "node scripts/setup-worker.mjs",
    "check-worker": "node scripts/run-worker.mjs check",
    "eval:setup": "node scripts/eval.mjs setup",
    "eval:draft": "node scripts/eval.mjs draft",
    "eval": "node scripts/eval.mjs run"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
