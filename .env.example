# ============================================================
# ClipVerse AI - settings and secret keys
# ------------------------------------------------------------
# HOW TO USE: copy this file, name the copy ".env" (same folder),
# then paste your real values into .env.
# .env is private and is never uploaded to GitHub.
# ============================================================

# ---------- Phase 0: Supabase (database, login, storage) - FREE tier ----------
# Where: supabase.com > your project > Project Settings > API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The "publishable" key (starts with sb_publishable_). Safe to use in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# The address of the website. Used in sign-up confirmation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Phase 1 (not needed yet) ----------
# The "secret" key (starts with sb_secret_). SERVER/WORKER ONLY - never share it.
# SUPABASE_SECRET_KEY=

# Speech-to-text provider: groq (free tier) | faster_whisper (local, free)
# STT_PROVIDER=groq
# GROQ_API_KEY=

# Moment-picking AI provider: gemini (free tier) | anthropic (paid)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
