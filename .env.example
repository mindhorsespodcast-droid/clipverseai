# ============================================================
# ClipVerse AI - settings and secret keys
# ------------------------------------------------------------
# HOW TO USE: copy this file, name the copy ".env" (same folder),
# then paste your real values into .env.
# .env is private and is never uploaded to GitHub.
# ============================================================

# ---------- Supabase (database + login) - FREE tier ----------
# Where: supabase.com > your project > Project Settings > Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The "publishable" key (starts with sb_publishable_). Safe to use in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# The address of the website. Used in sign-up confirmation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Phase 1: the video worker ----------
# The SECRET key (starts with sb_secret_). Lets the worker update any project.
# Never share it, never put it in a NEXT_PUBLIC_ setting.
SUPABASE_SECRET_KEY=

# Speech-to-text. Groq free tier: console.groq.com > API Keys
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# AI that picks the moments. Google AI Studio free tier: aistudio.google.com > Get API key
# (Free tier: Google may use what we send to improve its products - our own test videos only.)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# "npm run check-worker" lists the model names your key can use if this one isn't available.
GEMINI_MODEL=gemini-2.5-flash

# ---------- Optional tuning (defaults shown) ----------
# Where uploaded videos and finished clips are kept (a folder on this computer).
# STORAGE_DIR=storage
# CLIP_MIN_SECONDS=15
# CLIP_MAX_SECONDS=90
# MAX_CLIPS_PER_VIDEO=10
# MAX_VIDEO_HOURS=6
# Used only to show cost estimates in rupees.
# USD_TO_INR=88
